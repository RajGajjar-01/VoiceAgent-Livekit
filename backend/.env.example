# Postgres
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=changethis
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voiceagent

# pgAdmin
PGADMIN_EMAIL=admin@voiceagent.dev
PGADMIN_PASSWORD=changethis

# Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changethis
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Session / crypto — must be generated locally, never commit real values here
# JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REFRESH_TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
REFRESH_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=changethis
LIVEKIT_API_SECRET=changethis

# Deepgram (STT) — console.deepgram.com; $200 trial credit, not indefinitely free
DEEPGRAM_API_KEY=changethis

# LLM — generic LLM_* names so swapping providers is an env change, not a
# code change. Defaults point at Groq's OpenAI-compatible endpoint.
LLM_API_KEY=changethis
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ElevenLabs (TTS) — elevenlabs.io; free tier has a monthly character quota
ELEVENLABS_API_KEY=changethis
ELEVENLABS_VOICE_ID=
